  "insights": {
    "the_pivot": {
      "en": "WIN Semi navigated the severe 2022-2023 smartphone destocking trough by trimming workforce from 3,480 to 2,980, achieving margin turnaround (+4.55pp) as Wi-Fi 7 FEM and AI optical transceivers ramped.",
      "zh": "穩懋透過將員工人數由 3,480 人精簡至 2,980 人度過智慧手機去庫存谷底，隨 Wi-Fi 7 前端模組與 AI 光模組放量，毛利率由 21.89% 強勢回升至 26.44%（+4.55pp）迎來營運獲利反轉拐點。"
    },
    "productivity": {
      "en": "Gross profit per employee rebounded to $46.7k in 2024 and is projected to surpass $55k in 2025.",
      "zh": "2024 年人均毛利回升至 4.67 萬美元，2025 年預期將突破 5.5 萬美元。"
    },
    "value_vs_volume": {
      "en": "Cellular PA and Wi-Fi FEM account for over 81% of total value, while emerging GaN-on-SiC and InP optical transceivers drive high-margin AI datacenter growth.",
      "zh": "行動通訊 PA 與 Wi-Fi FEM 佔營收逾 81%，而 GaN-on-SiC 與 InP 光通訊雷射晶圓則引領高毛利 AI 資料中心成長。"
    }
  },
