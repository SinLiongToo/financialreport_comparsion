  "insights": {
    "en": {
      "pivot": "Quarterly headcount smoothly held between 2,950 and 3,050 FTEs while quarterly Gross Margin expanded from 20.0% in mid-2023 to ~29.5% in 2025.",
      "productivity": "Quarterly gross profit per FTE rebounded from $7.0k/quarter ($28k annualized) in 2023 to $15.5k/quarter ($62k annualized) in 2025.",
      "leverage": "Quarterly operating margins returned to positive territory from -7.4% in 2023 Q1 to +9.5% in 2025 Q3 as fab utilization recovered above 65%.",
      "rd": "Quarterly R&D expenditure consistently invested at $19.4M-$22.0M (~13-15% of rev) dedicated to 0.1um GaN-on-SiC and InP high-speed optical platforms."
    },
    "zh": {
      "pivot": "季度員工人數平滑控制在 2,950 至 3,050 人之間，單季毛利率由 2023 年中 20.0% 擴張至 2025 年約 29.5%。",
      "productivity": "單季人均毛利產值由 2023 年低谷之 0.7 萬美元（年化約 2.8 萬美元）翻倍至 2025 年 1.55 萬美元（年化約 6.2 萬美元）。",
      "leverage": "單季營業利益率由 2023 Q1 之 -7.4% 虧損強勁翻正至 2025 Q3 之 +9.5%，晶圓廠產能利用率回升至 65% 以上。",
      "rd": "每季研發投入維持在 1,940 萬～2,200 萬美元（營收佔比 13%～15%），全力投入 0.1 微米 GaN-on-SiC 及 InP 超高速光通訊製程。"
    }
