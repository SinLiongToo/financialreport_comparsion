  "insights": {
    "the_pivot": {
      "en": "STM's Gross Margin surged from 37.1% (2020) to a peak of 47.95% (2023) during the auto chip shortage, then normalized to 39.40% in 2024 due to EV inventory adjustments and fab capacity underutilization charges.",
      "zh": "意法半導體毛利率在車用晶片荒期間自 37.1%（2020）飆升至 47.95% 歷史峰值（2023），2024 年受電動車客戶庫存調整與工廠稼動率下滑（閒置產能損失）影響，回跌正常化至 39.40%，展現半導體製造典型的產能槓桿週期。"
    },
    "productivity": {
      "en": "Revenue per FTE reached $273.6k in 2024 with Gross Profit per FTE at $107.8k, supported by high-automation European 300mm/200mm fabs.",
      "zh": "2024 年人均營收達 27.36 萬美元，人均毛利為 10.78 萬美元，仰賴歐洲 12 吋/8 吋高度自動化晶圓廠營運支撐。"
    },
    "value_vs_volume": {
      "en": "Automotive & Discrete (ADG) expanded to 44% of revenue led by Silicon Carbide (SiC MOSFET) modules, while STM32 general-purpose MCUs (MDG) underwent inventory digestion.",
      "zh": "車用與分離式元件 (ADG) 在碳化矽 (SiC MOSFET) 模組帶動下佔比達 44%，而 STM32 通用微控制器 (MDG) 則處於工業去庫存週期。"
    }
  },
